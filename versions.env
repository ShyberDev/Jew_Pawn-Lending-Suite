# ============================================================================
#  Jew_Pawn-Lending-Suite  —  pinned versions
# ----------------------------------------------------------------------------
#  The bundle was built and tested against the versions below.
#  The custom/patched apps are VENDORED inside ./apps (nothing to download).
#  Frappe & ERPNext are fetched automatically by install.sh at these commits,
#  so you never install them separately.
# ============================================================================

# ---- Frappe framework (upstream) -------------------------------------------
FRAPPE_REPO="https://github.com/frappe/frappe"
FRAPPE_BRANCH="develop"
FRAPPE_COMMIT="8a43de00d7f1e304598c910f0aa35aa384d474d7"

# ---- ERPNext (upstream) ----------------------------------------------------
ERPNEXT_REPO="https://github.com/frappe/erpnext"
ERPNEXT_BRANCH="develop"
ERPNEXT_COMMIT="8c24c5bd68aa6fd6db155c46fb6f05e201cc6d69"

# ---- Custom apps (vendored in ./apps, nothing to download) -----------------
#   jewellery_management  — Jewellery ERP
#   lending               — Money Lending (patched: desk sidebar fix)
#   pawn_shop             — Pawn Shop + Khatabook
VENDORED_APPS="jewellery_management lending pawn_shop"

# ---- Defaults (override on the command line or via env) --------------------
SITE_NAME="${SITE_NAME:-library.local}"
BENCH_DIR="${BENCH_DIR:-$HOME/frappe-bench}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-admin}"
