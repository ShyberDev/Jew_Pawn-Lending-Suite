  "html": "<div style=\"text-align:center; margin-bottom:20px;\">\n    <h2 style=\"margin-bottom:5px;\">JEWELLERY ORDER</h2>\n    <div>Order No: <strong>{{ doc.name }}</strong></div>\n</div>\n\n<table class=\"table table-bordered\" style=\"width:100%;\">\n    <tr>\n        <th style=\"width:20%;\">Customer</th>\n        <td style=\"width:30%;\">{{ doc.customer }}</td>\n        <th style=\"width:20%;\">Order Date</th>\n        <td style=\"width:30%;\">{{ doc.get_formatted(\"order_date\") }}</td>\n    </tr>\n    <tr>\n        <th>Contact Number</th>\n        <td>{{ doc.contact_number }}</td>\n        <th>Delivery Date</th>\n        <td>{{ doc.get_formatted(\"delivery_date\") }}</td>\n    </tr>\n    <tr>\n        <th>Order Status</th>\n        <td colspan=\"3\">{{ doc.order_status }}</td>\n    </tr>\n</table>\n\n<h4 style=\"margin-top:20px;\">JEWELLERY DETAILS</h4>\n\n<table class=\"table table-bordered\" style=\"width:100%; font-size:12px;\">\n    <thead>\n        <tr>\n            <th>Sr</th>\n            <th>Item Name</th>\n            <th>Material</th>\n            <th>Purity</th>\n            <th>Gross Wt.</th>\n            <th>Stone Wt.</th>\n            <th>Net Wt.</th>\n            <th>Rate/g</th>\n            <th>Making</th>\n            <th>Labour</th>\n            <th>Total</th>\n            \n            <th>Status</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        {%- for row in doc.jewellery_items -%}\n\n        {% set item_name = frappe.db.get_value(\n            \"Jewellery Item Type\",\n            row.item_name,\n            \"item_type_name\"\n        ) %}\n\n        {% set purity_name = frappe.db.get_value(\n            \"Metal Purity\",\n            row.purity,\n            \"purity_name\"\n        ) %}\n\n        <tr>\n            <td>{{ row.idx }}</td>\n\n            <td>{{ item_name or row.item_name }}</td>\n\n            <td>{{ row.material }}</td>\n\n            <td>{{ purity_name or row.purity }}</td>\n\n            <td>{{ row.gross_weight }}</td>\n\n            <td>{{ row.stone_weight }}</td>\n\n            <td>{{ row.net_weight }}</td>\n\n            <td>{{ row.get_formatted(\"rate_per_gram\", doc) }}</td>\n\n            <td>{{ row.get_formatted(\"making_charges\", doc) }}</td>\n\n            <td>{{ row.get_formatted(\"labour_charge\", doc) }}</td>\n\n            <td>{{ row.get_formatted(\"total_amount\", doc) }}</td>\n\n            \n\n            <td>{{ row.status }}</td>\n        </tr>\n\n        {%- endfor -%}\n    </tbody>\n</table>\n\n<h4 style=\"margin-top:20px;\">PAYMENT / BILLING SUMMARY</h4>\n\n<table class=\"table table-bordered\" style=\"width:45%; margin-left:auto;\">\n    <tr>\n        <th>Subtotal</th>\n        <td style=\"text-align:right;\">\n            {{ doc.get_formatted(\"subtotal\") }}\n        </td>\n    </tr>\n\n    <tr>\n        <th>Discount</th>\n        <td style=\"text-align:right;\">\n            {{ doc.get_formatted(\"discount\") }}\n        </td>\n    </tr>\n\n    <tr>\n        <th>Grand Total</th>\n        <td style=\"text-align:right;\">\n            <strong>{{ doc.get_formatted(\"grand_total\") }}</strong>\n        </td>\n    </tr>\n\n    <tr>\n        <th>Total Paid</th>\n        <td style=\"text-align:right;\">\n            {{ doc.get_formatted(\"advance_amount\") }}\n        </td>\n    </tr>\n\n    <tr>\n        <th>Balance Amount</th>\n        <td style=\"text-align:right;\">\n            <strong>{{ doc.get_formatted(\"balance_amount\") }}</strong>\n        </td>\n    </tr>\n</table>\n\n<div style=\"margin-top:40px; text-align:center;\">\n    <small>Thank you for your business.</small>\n</div>",
