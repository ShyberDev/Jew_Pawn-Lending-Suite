  "format_data": null,
  "html": "<style>\n    .jpi {\n        font-size: 11px;\n        line-height: 1.25;\n    }\n\n    .jpi-title {\n        text-align: center;\n        margin-bottom: 12px;\n    }\n\n    .jpi-title h2 {\n        margin: 0;\n        font-size: 18px;\n    }\n\n    .jpi-title .invoice-no {\n        margin-top: 4px;\n        font-weight: 600;\n    }\n\n    .jpi table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 10px;\n    }\n\n    .jpi th,\n    .jpi td {\n        border: 1px solid #555;\n        padding: 4px 5px;\n        vertical-align: middle;\n    }\n\n    .jpi th {\n        font-weight: 600;\n        text-align: center;\n    }\n\n    .jpi .section-title {\n        text-align: center;\n        font-size: 13px;\n        font-weight: 700;\n        margin: 12px 0 6px 0;\n    }\n\n    .jpi .center {\n        text-align: center;\n    }\n\n    .jpi .right {\n        text-align: right;\n    }\n\n    /* ==========================================\n       PURCHASE SUMMARY\n       ========================================== */\n\n    .purchase-summary-row {\n        width: 100%;\n        border-collapse: separate !important;\n        border-spacing: 5px;\n        margin-bottom: 7px !important;\n    }\n\n    .purchase-summary-row td {\n        border: 1px solid #555;\n        padding: 0 !important;\n        text-align: center;\n        vertical-align: middle;\n    }\n\n    .purchase-summary-label {\n        display: block;\n        font-weight: 600;\n        padding: 5px 3px 4px 3px;\n        border-bottom: 1px solid #555;\n        line-height: 1.15;\n    }\n\n    .purchase-summary-value {\n        display: block;\n        font-weight: 600;\n        padding: 6px 3px;\n        line-height: 1.15;\n    }\n\n    .purchase-summary-grand {\n        font-size: 12px;\n        font-weight: 700;\n    }\n\n    .footer {\n        margin-top: 25px;\n        text-align: center;\n        font-weight: 600;\n    }\n</style>\n\n\n{# ======================================================\n   WEIGHT FORMATTER\n\n   Rules:\n   25       -> 25\n   25.1     -> 25.100\n   25.12    -> 25.120\n   25.123   -> 25.123\n   25.1238  -> 25.124\n   ====================================================== #}\n\n{% macro weight(value) -%}\n    {% set v = value|float %}\n\n    {% if v == v|int %}\n        {{ v|int }}\n    {% else %}\n        {{ \"%.3f\"|format(v) }}\n    {% endif %}\n{%- endmacro %}\n\n\n<div class=\"jpi\">\n\n    <!-- ==================================================\n         HEADER\n         ================================================== -->\n\n    <div class=\"jpi-title\">\n        <h2>JEWELLERY PURCHASE INVOICE</h2>\n\n        <div class=\"invoice-no\">\n            Invoice No: {{ doc.name }}\n        </div>\n    </div>\n\n\n    <!-- ==================================================\n         BASIC INFORMATION\n         ================================================== -->\n\n    <div class=\"section-title\">\n        BASIC INFORMATION\n    </div>\n\n    <table>\n        <tr>\n\n            <th>Supplier Name</th>\n            <td>\n                {{ doc.supplier_name or \"\" }}\n            </td>\n\n            <th>Supplier GSTIN</th>\n            <td>\n                {{ doc.supplier_gstin or \"\" }}\n            </td>\n\n            <th>Purchase Date</th>\n            <td>\n                {{ doc.get_formatted(\"purchase_date\") }}\n            </td>\n\n            <th>Supplier Invoice No</th>\n            <td>\n                {{ doc.supplier_invoice_no or \"\" }}\n            </td>\n\n        </tr>\n    </table>\n\n\n    <!-- ==================================================\n         PURCHASE DETAILS\n         ================================================== -->\n\n    <div class=\"section-title\">\n        PURCHASE DETAILS\n    </div>\n\n\n    {# Determine optional columns #}\n\n    {% set ns = namespace(\n        show_net_weight=false,\n        show_metal_value=false,\n        show_making_charges=false,\n        show_stone_charges=false,\n        show_other_charges=false\n    ) %}\n\n\n    {% for row in doc.items %}\n\n        {% set gross = row.gross_weight or 0 %}\n        {% set net = row.net_weight or 0 %}\n\n\n        {# Show Net Weight only when\n           Gross Weight and Net Weight are different #}\n\n        {% if net > 0 and net != gross %}\n            {% set ns.show_net_weight = true %}\n        {% endif %}\n\n\n        {# Show Gold/Silver Value only when\n           at least one additional charge exists #}\n\n        {% if (row.making_charges or 0) > 0 %}\n            {% set ns.show_making_charges = true %}\n            {% set ns.show_metal_value = true %}\n        {% endif %}\n\n\n        {% if (row.stone_charges or 0) > 0 %}\n            {% set ns.show_stone_charges = true %}\n            {% set ns.show_metal_value = true %}\n        {% endif %}\n\n\n        {% if (row.other_charges or 0) > 0 %}\n            {% set ns.show_other_charges = true %}\n            {% set ns.show_metal_value = true %}\n        {% endif %}\n\n    {% endfor %}\n\n\n    <table>\n\n        <thead>\n            <tr>\n\n                <th>Sr</th>\n                <th>Item</th>\n                <th>Gross Wt</th>\n\n                {% if ns.show_net_weight %}\n                    <th>Net Wt</th>\n                {% endif %}\n\n                <th>Purity</th>\n                <th>Wastage</th>\n                <th>Pure Eq. Wt</th>\n                <th>Pure Rate</th>\n\n\n                {% if ns.show_metal_value %}\n                    <th>Gold/Silver Value</th>\n                {% endif %}\n\n\n                {% if ns.show_making_charges %}\n                    <th>Making</th>\n                {% endif %}\n\n\n                {% if ns.show_stone_charges %}\n                    <th>Stone</th>\n                {% endif %}\n\n\n                {% if ns.show_other_charges %}\n                    <th>Other</th>\n                {% endif %}\n\n\n                <th>Total</th>\n\n            </tr>\n        </thead>\n\n\n        <tbody>\n\n        {% for row in doc.items %}\n\n            {% set purity_display = \"\" %}\n\n            {% if row.purity %}\n\n                {% set purity_display = frappe.db.get_value(\n                    \"Metal Purity\",\n                    row.purity,\n                    \"purity_name\"\n                ) or row.purity %}\n\n            {% endif %}\n\n\n            <tr>\n\n                <!-- Sr -->\n\n                <td class=\"center\">\n                    {{ row.idx }}\n                </td>\n\n\n                <!-- Item -->\n\n                <td>\n                    {{ row.item_name or \"\" }}\n                </td>\n\n\n                <!-- Gross Weight -->\n\n                <td class=\"right\">\n                    {{ weight(row.gross_weight or 0) }} g\n                </td>\n\n\n                <!-- Net Weight -->\n\n                {% if ns.show_net_weight %}\n\n                    <td class=\"right\">\n\n                        {% if row.net_weight\n                              and row.net_weight != row.gross_weight %}\n\n                            {{ weight(row.net_weight) }} g\n\n                        {% endif %}\n\n                    </td>\n\n                {% endif %}\n\n\n                <!-- Purity -->\n\n                <td class=\"center\">\n                    {{ purity_display }}\n                </td>\n\n\n                <!-- Wastage -->\n\n                <td class=\"right\">\n                    {{ row.wastage_percentage or 0 }}%\n                </td>\n\n\n                <!-- Pure Equivalent Weight -->\n\n                <td class=\"right\">\n                    {{ weight(row.pure_weight_24k or 0) }} g\n                </td>\n\n\n                <!-- Pure Rate -->\n\n                <td class=\"right\">\n\n                    {% if row.rate_24k %}\n\n                        ₹{{ row.rate_24k|float|round(0, 'ceil')|int }}\n\n                    {% else %}\n\n                        ₹0\n\n                    {% endif %}\n\n                </td>\n\n\n                <!-- Gold / Silver Value -->\n\n                {% if ns.show_metal_value %}\n\n                    <td class=\"right\">\n\n                        {% if row.metal_value and row.metal_value > 0 %}\n\n                            ₹{{ row.metal_value|float|round(0, 'ceil')|int }}\n\n                        {% endif %}\n\n                    </td>\n\n                {% endif %}\n\n\n                <!-- Making Charges -->\n\n                {% if ns.show_making_charges %}\n\n                    <td class=\"right\">\n\n                        {% if row.making_charges\n                              and row.making_charges > 0 %}\n\n                            ₹{{ row.making_charges|float|round(0, 'ceil')|int }}\n\n                        {% endif %}\n\n                    </td>\n\n                {% endif %}\n\n\n                <!-- Stone Charges -->\n\n                {% if ns.show_stone_charges %}\n\n                    <td class=\"right\">\n\n                        {% if row.stone_charges\n                              and row.stone_charges > 0 %}\n\n                            ₹{{ row.stone_charges|float|round(0, 'ceil')|int }}\n\n                        {% endif %}\n\n                    </td>\n\n                {% endif %}\n\n\n                <!-- Other Charges -->\n\n                {% if ns.show_other_charges %}\n\n                    <td class=\"right\">\n\n                        {% if row.other_charges\n                              and row.other_charges > 0 %}\n\n                            ₹{{ row.other_charges|float|round(0, 'ceil')|int }}\n\n                        {% endif %}\n\n                    </td>\n\n                {% endif %}\n\n\n                <!-- Total -->\n\n                <td class=\"right\">\n\n                    ₹{{ row.total_amount|float|round(0, 'ceil')|int }}\n\n                </td>\n\n            </tr>\n\n        {% endfor %}\n\n        </tbody>\n\n    </table>\n\n\n    <!-- ==================================================\n         PURCHASE SUMMARY\n         Hidden when only one item\n         ================================================== -->\n\n    {% if doc.items|length > 1 %}\n\n\n        <div class=\"section-title\">\n            PURCHASE SUMMARY\n        </div>\n\n\n        {# Count charges #}\n\n        {% set summary = namespace(\n            making=false,\n            stone=false,\n            other=false,\n            charge_count=0\n        ) %}\n\n\n        {% if (doc.total_making_charges or 0) > 0 %}\n\n            {% set summary.making = true %}\n            {% set summary.charge_count =\n                summary.charge_count + 1 %}\n\n        {% endif %}\n\n\n        {% if (doc.total_stone_charges or 0) > 0 %}\n\n            {% set summary.stone = true %}\n            {% set summary.charge_count =\n                summary.charge_count + 1 %}\n\n        {% endif %}\n\n\n        {% if (doc.total_other_charges or 0) > 0 %}\n\n            {% set summary.other = true %}\n            {% set summary.charge_count =\n                summary.charge_count + 1 %}\n\n        {% endif %}\n\n\n        <!-- ==============================================\n             CASE 1\n             NO CHARGES\n             7 BOXES IN ONE ROW\n             ============================================== -->\n\n        {% if summary.charge_count == 0 %}\n\n            <table class=\"purchase-summary-row\">\n\n                <tr>\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Gross Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.gross_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Net Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.net_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Pure Equivalent Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.total_pure_weight_24k or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Metal Value\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_metal_value\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Grand Total\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.grand_total\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Paid\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.total_paid\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Balance Amount\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.balance_amount\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                </tr>\n\n            </table>\n\n\n        <!-- ==============================================\n             CASE 2\n             ONE OR TWO CHARGES\n             ONE ROW\n             ============================================== -->\n\n        {% elif summary.charge_count <= 2 %}\n\n            <table class=\"purchase-summary-row\">\n\n                <tr>\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Gross Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.gross_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Net Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.net_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Pure Equivalent Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.total_pure_weight_24k or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Metal Value\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_metal_value\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    {% if summary.making %}\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Making Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_making_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                    {% endif %}\n\n\n                    {% if summary.stone %}\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Stone Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_stone_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                    {% endif %}\n\n\n                    {% if summary.other %}\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Other Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_other_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                    {% endif %}\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Grand Total\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.grand_total\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Paid\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.total_paid\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Balance Amount\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.balance_amount\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                </tr>\n\n            </table>\n\n\n        <!-- ==============================================\n             CASE 3\n             ALL THREE CHARGES\n             3 ROWS\n             ============================================== -->\n\n        {% else %}\n\n\n            <!-- ROW 1 -->\n\n            <table class=\"purchase-summary-row\">\n\n                <tr>\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Gross Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.gross_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Net Total Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.net_total_weight or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Pure Equivalent Weight\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n                            {{ weight(doc.total_pure_weight_24k or 0) }} g\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Metal Value\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_metal_value\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                </tr>\n\n            </table>\n\n\n            <!-- ROW 2 -->\n\n            <table class=\"purchase-summary-row\">\n\n                <tr>\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Making Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_making_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Stone Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_stone_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Other Charges\n                        </span>\n\n                        <span class=\"purchase-summary-value\">\n\n                            ₹{{ doc.total_other_charges\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                </tr>\n\n            </table>\n\n\n            <!-- ROW 3 -->\n\n            <table class=\"purchase-summary-row\">\n\n                <tr>\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Grand Total\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.grand_total\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Total Paid\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.total_paid\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n\n                    <td>\n                        <span class=\"purchase-summary-label\">\n                            Balance Amount\n                        </span>\n\n                        <span class=\"purchase-summary-value purchase-summary-grand\">\n\n                            ₹{{ doc.balance_amount\n                                |float\n                                |round(0, 'ceil')\n                                |int }}\n\n                        </span>\n                    </td>\n\n                </tr>\n\n            </table>\n\n        {% endif %}\n\n    {% endif %}\n\n\n    <!-- ==================================================\n         PAYMENT DETAILS\n         ================================================== -->\n\n    {% if doc.payments and doc.payments|length > 0 %}\n\n        <div class=\"section-title\">\n            PAYMENT DETAILS\n        </div>\n\n\n        <table>\n\n            <thead>\n\n                <tr>\n\n                    <th>Sr</th>\n                    <th>Payment Date</th>\n                    <th>Payment Mode</th>\n                    <th>Reference No</th>\n                    <th>Amount Paid</th>\n\n                </tr>\n\n            </thead>\n\n\n            <tbody>\n\n            {% for payment in doc.payments %}\n\n                <tr>\n\n                    <td class=\"center\">\n                        {{ payment.idx }}\n                    </td>\n\n                    <td>\n                        {{ payment.get_formatted(\"payment_date\") }}\n                    </td>\n\n                    <td class=\"center\">\n                        {{ payment.payment_mode }}\n                    </td>\n\n                    <td>\n                        {{ payment.reference_no or \"\" }}\n                    </td>\n\n                    <td class=\"right\">\n\n                        ₹{{ payment.amount\n                            |float\n                            |round(0, 'ceil')\n                            |int }}\n\n                    </td>\n\n                </tr>\n\n            {% endfor %}\n\n            </tbody>\n\n        </table>\n\n    {% endif %}\n\n\n    <!-- ==================================================\n         FOOTER\n         ================================================== -->\n\n    <div class=\"footer\">\n        Thank You\n    </div>\n\n</div>",
