<?xml version="1.0" encoding="utf-8"?>
<!-- #080 security: the shop's ledger is local-only and must never be copied
     off the phone by the platform. `allowBackup="false"` covers older
     releases; these rules close Android 12+ cloud backup and device-to-device
     transfer as well. The app has its own explicit backup/restore through the
     file picker, which the shop controls. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
